{
  "name": "granelli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Granelli: un mondo di granelli che reagiscono tra loro. Si parte da quattro elementi e si scopre tutto il resto.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
