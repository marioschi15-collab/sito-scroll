{
  "name": "mc-tattoo-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sito vetrina di M.C. Tattoo Studio: pagina singola in React con animazioni Motion",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "anteprima": "tsc -p tsconfig.json && vite build --mode anteprima",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4"
  }
}
