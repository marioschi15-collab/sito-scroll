{
  "name": "@spalla/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Spalla desktop: Nucleo (servizi), shell Electron (finestra, barra, IPC) e CLI di sviluppo",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "tsx src/cli/spalla-dev.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/renderer/tsconfig.json && tsc -p test/tsconfig.shell.json",
    "test": "vitest run --passWithNoTests && vitest run -c vitest.renderer.config.ts --passWithNoTests",
    "typecheck:renderer": "tsc -p src/renderer/tsconfig.json",
    "test:renderer": "vitest run -c vitest.renderer.config.ts",
    "dev:app": "electron-vite dev",
    "build:app": "electron-vite build",
    "start:app": "electron-vite preview",
    "smoke:finestra": "node test/e2e/finestra-smoke.mjs",
    "rebuild:electron": "electron-builder install-app-deps",
    "rebuild:node": "pnpm rebuild better-sqlite3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.307",
    "@grammyjs/auto-retry": "^2.0.0",
    "@grammyjs/files": "^1.1.0",
    "@spalla/it-copy": "workspace:*",
    "@spalla/schema": "workspace:*",
    "@spalla/workspace-templates": "workspace:*",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^12.0.0",
    "croner": "^9.0.0",
    "grammy": "^1.46.0",
    "node-pty": "^1.1.0",
    "ogg-opus-decoder": "^1.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.6.0",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "^1.13.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "jsdom": "^30.1.3",
    "playwright-core": "1.64.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^3.0.0"
  }
}
