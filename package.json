{
  "name": "spalla",
  "private": true,
  "version": "0.0.1",
  "description": "Spalla: assistente personale con onboarding automatico (prototipo)",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev": "pnpm --filter @spalla/desktop run dev"
  }
}
